# Never expose these as NEXT_PUBLIC variables.
OPENAI_API_KEY=
AI_BASE_URL=https://api.avalai.ir/v1
# Set a model available to your account that supports Responses Structured Outputs.
# Photo questions also require image input / vision support.
OPENAI_MODEL=gpt-6-luna
# local (no API calls) or openai
TUTOR_MODE=openai
